---
/** Iconos SVG en línea (trazo de 24×24). Decorativos: aria-hidden. */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;

const paths: Record<string, string> = {
  logo: '',
  trending: '<path d="M3 17l6-6 4 4 8-8"/><path d="M14 7h7v7"/>',
  letter: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  calendar: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M8 14h3v3H8z"/>',
  door: '<path d="M14 3H6a1 1 0 0 0-1 1v17h9"/><path d="M14 3l5 2v16l-5-1z"/><path d="M11 12h.01"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
  split: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M12 4v17"/><path d="M3 10h18"/>',
  wallet: '<path d="M3 7a2 2 0 0 1 2-2h13v4"/><path d="M3 7v11a2 2 0 0 0 2 2h15V9H5a2 2 0 0 1-2-2z"/><path d="M16 14h.01"/>',
  chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  check: '<path d="M20 6L9 17l-5-5"/>',
  lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  book: '<path d="M4 4h10a4 4 0 0 1 4 4v12H8a4 4 0 0 1-4-4z"/><path d="M18 20h2V6"/>',
  scale: '<path d="M12 3v18M5 21h14"/><path d="M6 7h12"/><path d="M6 7l-3 7a3 3 0 0 0 6 0zM18 7l-3 7a3 3 0 0 0 6 0z"/>',
  menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
};
const d = paths[name] ?? paths.info;
---

{
  name === 'logo' ? (
    <svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <rect width="32" height="32" rx="8" fill="var(--c-primary)" />
      <path d="M7 15.5 16 8l9 7.5V24a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1z" fill="none" stroke="var(--c-on-primary)" stroke-width="2.2" stroke-linejoin="round" />
      <path d="m12 18 3 3 5.5-6" fill="none" stroke="var(--c-on-primary)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  ) : (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={d} />
  )
}
