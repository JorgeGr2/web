---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { HERRAMIENTAS } from '../data/herramientas.mjs';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe o ha cambiado de dirección. Vuelve a la portada o elige una de nuestras calculadoras del alquiler." path="/404/" noindex>
  <div class="container">
    <header class="page-head page-head--404">
      <h1>No hemos encontrado esta página</h1>
      <p class="lead">Puede que la dirección esté mal escrita o que la página haya cambiado. Estas son nuestras calculadoras:</p>
    </header>
    <ul class="card-grid">
      {HERRAMIENTAS.map((h) => <ToolCard h={h} />)}
    </ul>
    <p><a class="btn" href="/">Volver a la portada</a></p>
  </div>
</BaseLayout>

<style>
  .page-head--404 {
    padding-top: var(--space-7);
  }
</style>
