---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import Icon from '../components/Icon.astro';
import { HERRAMIENTAS } from '../data/herramientas.mjs';
import { LIMITES_EXTRAORDINARIOS, ETIQUETA_ESTADO, ESTADO_NORMATIVO_FECHA, ULTIMO_IRAV_COMPROBADO } from '../data/normativa';
import { fechaCorta, mesLargo } from '../lib/fechas';
import { porcentaje } from '../lib/formato';
import { websiteLd } from '../lib/seo';
import { getCollection } from 'astro:content';
import { SITE } from '../config/site';

const rdl29 = LIMITES_EXTRAORDINARIOS.find((l) => l.id === 'rdl-29-2026')!;
const guias = (await getCollection('guias')).sort((a, b) => a.data.orden - b.data.orden).slice(0, 6);
const destacada = HERRAMIENTAS[0]!;
---

<BaseLayout
  title={`${SITE.siteName}: calculadoras del alquiler en España`}
  description="Calcula cuánto puede subir tu alquiler (IPC, IRAV y límite del 2 %), cuándo termina tu contrato, la fianza y el preaviso, con la ley española citada y fechada."
  path="/"
  jsonLd={[websiteLd()]}
>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <h1>Calcula y entiende tu alquiler, con la ley en la mano</h1>
        <p class="lead">
          Calculadoras gratuitas para inquilinos y propietarios en España: actualización de la renta, duración del contrato, fianza, preaviso y
          rentabilidad. Cada resultado explica los pasos y cita la norma aplicada.
        </p>
        <div class="btn-row">
          <a class="btn" href={destacada.path}>Calcular la subida del alquiler <Icon name="arrow" class="btn-icon" /></a>
          <a class="btn btn--ghost" href="/calculadoras/">Ver todas las calculadoras</a>
        </div>
        <ul class="trust-list">
          <li><Icon name="check" /><span>Sin registro y gratis. Los datos que escribes se calculan en tu navegador y no se envían.</span></li>
          <li><Icon name="check" /><span>Basado en fuentes oficiales: BOE, INE y Ministerio de Vivienda, con enlaces.</span></li>
          <li><Icon name="check" /><span>Fecha de revisión visible en cada página y registro público de cambios normativos.</span></li>
        </ul>
      </div>
      <aside class="card status-card" aria-labelledby="estado-titulo">
        <h2 id="estado-titulo">Estado de la normativa</h2>
        <dl class="kv">
          <dt>Revisado</dt>
          <dd>{fechaCorta(ESTADO_NORMATIVO_FECHA)}</dd>
          <dt>Límite del 2 % ({rdl29.norma})</dt>
          <dd>{fechaCorta(rdl29.desde)} – {fechaCorta(rdl29.hasta)}</dd>
          <dt>Situación</dt>
          <dd><span class="badge badge--warn">{ETIQUETA_ESTADO[rdl29.estado]}</span></dd>
          <dt>Último IRAV comprobado</dt>
          <dd>{porcentaje(ULTIMO_IRAV_COMPROBADO.valorPct)} ({mesLargo(ULTIMO_IRAV_COMPROBADO.mesDato)})</dd>
        </dl>
        <p class="small">Las calculadoras aplican automáticamente la norma vigente en la fecha que introduces.</p>
        <a href="/normativa/">Ver el estado completo y el historial</a>
      </aside>
    </div>
  </section>

  <div class="container">
    <section class="section" aria-labelledby="calc-titulo">
      <div class="section__head">
        <h2 id="calc-titulo">Calculadoras disponibles</h2>
        <a href="/calculadoras/">Todas las calculadoras</a>
      </div>
      <ul class="card-grid">
        {HERRAMIENTAS.map((h) => <ToolCard h={h} />)}
      </ul>
    </section>

    {
      guias.length > 0 && (
        <section class="section" aria-labelledby="guias-titulo">
          <div class="section__head">
            <h2 id="guias-titulo">Guías para entender tu caso</h2>
            <a href="/guias/">Todas las guías</a>
          </div>
          <ul class="article-list card">
            {guias.map((g) => (
              <li>
                <a href={`/guias/${g.id}/`}>{g.data.h1}</a>
                <p>{g.data.resumen}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="section prose" aria-labelledby="como-titulo">
      <h2 id="como-titulo">Cómo trabajamos</h2>
      <p>
        La normativa del alquiler en España cambia con frecuencia y depende de la fecha en que se firmó cada contrato. Por eso cada calculadora
        pregunta primero por las fechas, aplica las reglas vigentes en ese momento y te enseña el razonamiento. Si una norma está pendiente de
        convalidación o tiene interpretaciones distintas, lo decimos.
      </p>
      <p>
        No ofrecemos asesoramiento personalizado ni vendemos servicios jurídicos. Si tu caso es complejo, la información te ayudará a preparar la
        consulta con un profesional. Lee <a href="/metodologia/">cómo elaboramos y revisamos el contenido</a>.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .btn :global(.btn-icon) {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
