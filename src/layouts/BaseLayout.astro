---
import BaseHead, { type SeoProps } from '../components/BaseHead.astro';
import ThirdPartyHead from '../components/ThirdPartyHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';

type Props = SeoProps;
const props = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead {...props} />
    <ThirdPartyHead />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {
      !SITE.indexable && (
        <div class="preview-banner" role="status">
          Versión de revisión: el sitio aún no está publicado para buscadores (noindex).
        </div>
      )
    }
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
