# ---------------------------------------------------------------------------
# Configuración de Alquiler en Regla
# ---------------------------------------------------------------------------
# Copia este archivo como ".env" para trabajar en tu ordenador y rellena los
# valores. En Cloudflare Pages (o el alojamiento que uses) estas mismas
# variables se configuran en el panel: Settings → Environment variables.
#
# Todas las variables empiezan por PUBLIC_ porque su valor acaba visible en
# la web (por ejemplo, tu nombre en el aviso legal o tu ID de editor de
# AdSense). NUNCA pongas aquí contraseñas ni claves privadas: aquí no hace
# falta ninguna.
# ---------------------------------------------------------------------------

# --- Sitio -----------------------------------------------------------------
# URL definitiva, con https y SIN barra final. Se usa en canónicas y sitemap.
# Si la dejas vacía se usa https://www.alquilerenregla.es.
PUBLIC_SITE_URL=https://www.alquilerenregla.es

# Nombre visible del sitio.
PUBLIC_SITE_NAME=Alquiler en Regla

# "true" solo cuando el sitio esté listo para que Google lo indexe.
# Si es "false" (por defecto) todas las páginas llevan noindex y robots.txt
# bloquea el rastreo: útil para revisar la web antes del lanzamiento.
# Con "true" la compilación FALLA si faltan los datos del titular de abajo.
PUBLIC_SITE_INDEXABLE=false

# --- Titular (obligatorio por la LSSI-CE antes de indexar o monetizar) ------
# Nombre y apellidos o razón social del responsable del sitio.
PUBLIC_OWNER_NAME=
# NIF/NIE/CIF del titular.
PUBLIC_OWNER_NIF=
# Domicilio a efectos de notificaciones (calle, número, CP, municipio, provincia).
PUBLIC_OWNER_ADDRESS=
# Correo de contacto que aparecerá en la web (crea uno específico, p. ej.
# contacto@alquilerenregla.es).
PUBLIC_CONTACT_EMAIL=

# --- Google Search Console (opcional) --------------------------------------
# Solo el valor "content" de la metaetiqueta de verificación HTML.
# Si verificas por DNS (recomendado) déjalo vacío.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Google AdSense (rellenar SOLO tras crear la cuenta) -------------------
# ID de cliente con formato ca-pub-XXXXXXXXXXXXXXXX (16 dígitos).
# Al rellenarlo se carga el código de AdSense en todas las páginas y se
# genera /ads.txt automáticamente.
PUBLIC_ADSENSE_CLIENT=
# (Opcional) IDs de bloques de anuncios manuales creados en AdSense.
# Si los dejas vacíos, solo funcionarán los anuncios automáticos.
PUBLIC_ADSENSE_SLOT_INARTICLE=
PUBLIC_ADSENSE_SLOT_FOOTER=

# --- Google Analytics 4 (opcional) -----------------------------------------
# ID de medición con formato G-XXXXXXXXXX. Se carga con Consent Mode v2 y
# todos los consentimientos DENEGADOS por defecto; solo se conceden cuando
# la persona acepta en el mensaje de consentimiento de Google (CMP).
PUBLIC_GA4_ID=

# --- Cloudflare Web Analytics (opcional, sin cookies) ----------------------
# Pon "true" si lo activas en el panel de Cloudflare Pages (Metrics → Web
# Analytics). No añade código: sirve para que la política de privacidad lo
# mencione correctamente.
PUBLIC_CF_ANALYTICS_ENABLED=false

# --- Cloudflare Web Analytics manual (opcional) -----------------------------
# Solo si NO alojas en Cloudflare Pages (allí se activa con un clic, sin
# código). Token del "beacon" de Cloudflare Web Analytics.
PUBLIC_CF_BEACON_TOKEN=
